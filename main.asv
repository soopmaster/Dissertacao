% Main file of thesis project
% Runs all generalized functions for any number of vehichles
% Offline, initializes cell vector of vehiStruct
% Then initializes parametope propagation variables
% Online, runs specific vehichle and parametope dynamics 

close all;
clearvars;

% vehiSimStruct : struct (struct with components of main sim)
%   .vehiSt;
%   .x
%   .u
%   .alph
%   .y
%   .traj
%   .pathPlot
%   .ops

% === Sim Settings === %
simT = 5; % Sim time seconds
Ts = 0.01;
knum = simT/Ts;
inner_step = 20;
enable_prmtp = 0;

% === Init vehiStruct === &
vehi_vec = init_all_vehi(Ts); % Cell vec with vehiSimStruct
numVehi = length(vehi_vec);

trajt{1} = [0 4];
p1_ref = [0;0;1];
v1_ref = [0;0;0];
a1_ref = [0;0;0];
j1_ref = [0;0;0];
p2_ref = [5;-5;2];
v2_ref = [0;0;0];
a2_ref = [0;0;0];
j2_ref = [0;0;0];
pts_ref{1} = zeros(3*4,length(trajt{1}));
pts_ref{1}(1:6,1) = vehi_vec{1}.vehiSt.x0(1:6);
%pts_ref{1}(:,2) = [p1_ref; v1_ref; a1_ref; j1_ref];
pts_ref{1}(:,end) = [p2_ref; v2_ref; a2_ref; j2_ref];

trajt{2} = [0 1 4];
p1_ref = [-1;1;1];
v1_ref = [0;0;0];
a1_ref = [0;0;0];
j1_ref = [0;0;0];
p2_ref = [-5;5;2];
v2_ref = [0;0;0];
a2_ref = [0;0;0];
j2_ref = [0;0;0];
pts_ref{2} = zeros(3*4,length(trajt{2}));
pts_ref{2}(1:6,1) = vehi_vec{2}.vehiSt.x0(1:6);
pts_ref{2}(:,2) = [p1_ref; v1_ref; a1_ref; j1_ref];
pts_ref{2}(:,3) = [p2_ref; v2_ref; a2_ref; j2_ref];
for ind=1:numVehi
    vehi = vehi_vec{ind};

    % === Init Simulation Vectors === %
    vehi.x = zeros(vehi.vehiSt.nx,knum);
    vehi.x(:,1) = vehi.vehiSt.x0;
    vehi.u = zeros(vehi.vehiSt.nu,knum);
    vehi.u(:,1) = vehi.vehiSt.u0;

    vehi.alph = zeros(vehi.vehiSt.nx^2,knum/inner_step);
    vehi.alph(:,1) = reshape(vehi.vehiSt.alph0,[],1);

    vehi.y = zeros(1,knum/inner_step);
    vehi.y(1) = vehi.vehiSt.ysim0;

    % === Init Trajectories === %
    trajFunc = vehi.vehiSt.trajFunc;
    traj = trajFunc(trajt{ind}, pts_ref{ind}); % Compute Trajectory based on waypoints
    traj = [traj, traj(:,end).*ones(size(traj,1),knum-size(traj,2))]; % Pad Trajectory vec with last value
    vehi.traj = [traj; 0.*ones(1,knum); 0.*ones(1,knum)]; % Yaw and dYaw

    % === Define ops === %
    ops = sdpsettings('verbose',0);
    ops.plot.shade = 0.15;
    ops.plot.linewidth=0.05;
    ops.plot.wirestyle=':';
    ops.plot.edgecolor="#EB4B2D";
    vehi.ops = ops;

    vehi_vec{ind} = vehi;
end

% === Start Figure === %
enable_disp = 1;
fig=figure;
hold on;
grid on
axis equal
view(3)
xlabel('$x$','Interpreter','latex');
ylabel('$y$','Interpreter','latex');
zlabel('$z$','Interpreter','latex');
for ind=1:numVehi
    vehi_vec{ind}.wayptsPlot = plot3(pts_ref{ind}(1,:),pts_ref{ind}(2,:),pts_ref{ind}(3,:),'xr','DisplayName','target');
    vehi_vec{ind}.trajPlot = plot3(vehi_vec{ind}.traj(1,:), vehi_vec{ind}.traj(2,:), vehi_vec{ind}.traj(3,:) ,'r','DisplayName','r_T');
    %bodyPlot{ind} = patch(x(1,1), x(2,1), x(3,1), [0 0 1]);
    vehi_vec{ind}.pathPlot = animatedline(vehi_vec{ind}.x(1,1), vehi_vec{ind}.x(2,1), vehi_vec{ind}.x(3,1),'LineWidth',2.5, 'Color','b','LineStyle','-','DisplayName','Path');
end

% === Simulation === %
telapse_total = tic;
for k=1:knum-1 
    disp(['=== Computing ', num2str(k*Ts), '/', num2str(simT), 's ===']);
    for kVehi=1:numVehi
        vehi = vehi_vec{kVehi};
        ops = vehi.ops;
       
        % === Calculate Control action === %
        ctrlFunc = vehi.vehiSt.contrlFunc;
        vehi.u(:,k) = ctrlFunc(vehi.x(:,k), vehi.traj(:,k));
    
        % === Propagate Parametope === %
        if enable_prmtp && ~mod(k+inner_step-1,inner_step)
            inner_k = (k+inner_step-1)/inner_step;
            telapse_k = tic;
            if enable_disp
                disp('----------------');
                disp(['Computing ', num2str(k), ' time interval ']);
            end
            jacFunc = vehi.vehiSt.jacFunc;
            Dfxo = jacFunc(vehi.x(:,k), vehi.u(:,k));

            alph = reshape(vehi.alph(:,inner_k),vehi.vehiSt.nx,[]);
            alphk_1 = runge_kutta4(@(y) prmtpU(y,-Dfxo,vehi.vehiSt.nx),Ts*inner_step,alph);
            vehi.alph(:,inner_k+1) = reshape(alphk_1,[],1);
    
            vbds_ext(:,1) = vehi.vehiSt.vbds_init(:,1)+[vehi.x(:,k); vehi.u(:,k)];
            vbds_ext(:,2) = vehi.vehiSt.vbds_init(:,2)+[vehi.x(:,k); vehi.u(:,k)];
    
            % Calculate c just once outside of runge-kutta
            [alph_err,parametope_c] = prmtpEllips_c(vehi.vehiSt.rStrt,vehi.vehiSt.symvars,vbds_ext,-Dfxo,vehi.alph(:,inner_k),vehi.vehiSt.nx,vehi.vehiSt.rCode,vehi.vehiSt.rHasVarMx,vehi.vehiSt.rConstDfMx);
            vehi.y(inner_k+1) = runge_kutta4(@(y) prmtpE(y,parametope_c^-2), Ts*inner_step, vehi.y(inner_k));

            if enable_disp
                plotParametope(vehi.y(inner_k+1),alph,vehi.x(:,k),vehi.vehiSt.nx,ops,fig);
            end
                
            disp(['Computing time for interval: ', num2str(toc(telapse_k)), 's']);
        end

        % === Calculate System === %
        dynFunc = vehi.vehiSt.dynFunc;
        vehi.x(:,k+1) = runge_kutta4(@(y) dynFunc(y,vehi.u(:,k)), Ts, vehi.x(:,k));
        
        addpoints(vehi.pathPlot,vehi.x(1,k), vehi.x(2,k), vehi.x(3,k));

        vehi_vec{kVehi} = vehi;

        legend({'target', 'r_T', 'Path'});
        drawnow;
        pause(Ts);
    end
end
hold off;
disp(['Total sim computing time: ', num2str(toc(telapse_total)), 's']);

function plotParametope(y,alph,x,nx,ops,fig)
alph_pre = y^-1.*alph;
X.G = inv(sqrtm(alph_pre));
X.c = x;
X.A = zeros(0,nx);
X.b = zeros(0,1);
X.idx = [nx];
X.type = [2];
[Fc,p] = compileCCG(X);
plot(Fc,p(1:3),ops.plot.edgecolor,300,ops);
drawnow;
end
