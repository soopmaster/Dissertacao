function [cM,c] = prmtpEllips_c(range_struct,symvars,varbounds,Dfxo_vec,alph_vec,dim,code,hasVarMx,constDfMx)
% Computes offset constant "c" of ellipsoidal parametope
    % Variables for ODE: x = y(k)
    %   E(xo,alph,y) = c*y
    % where
    %   c = max_i(max(eig((alph*(Mi-Df(xo))*alph^-1)'+ alph*(Mi-Df(xo))*alph^-1))
    % and
    %   Mi \in M (set of interval Mixed Jacobian Matrices)

    % Input variables:
    %   Df_vec: vectorised jacobian
    %   vars: symbolic variables
    %   varmin: minimum bound of vars
    %   varmax: maximum bound of vars
    %   xo: point
    %   alph: value of alpha at instant
    %   dim: dimension of vars

    %Df = reshape(Df_vec,dim,[]);
    alph = reshape(alph_vec,dim,[]);

    Dfxo = reshape(Dfxo_vec,dim,[]);

    range_vec = zeros(1,2); % Contains range intervals of non-constant elements in Df
    % Organized in column order of Df
    ind = 1;
    for j=1:size(hasVarMx,2)
        for i=1:size(hasVarMx,1)
            switch hasVarMx(i,j)
                case 1
                    range_struct{i,j} = updateElements(range_struct{i,j},symvars,varbounds);
                    range_vec(ind,:) = range_struct{i,j}.r;
                    ind = ind+1;
                case -1
                    range_struct{i,j} = updateElements(range_struct{i,j},symvars,varbounds);
                    constDfMx(i,j) = range_struct{i,j}.r(1);
            end
        end
    end
    
    nvar = size(code,1);
    c = -inf;
    cM
    for k=1:2^nvar-1
        Mi = constDfMx;
        ind = 1;
        for j=1:size(Mi,2)
            for i=1:size(Mi,1)
                if hasVarMx(i,j)==1
                    Mi(i,j) = range_vec(ind,code(ind,k));
                    ind=ind+1;
                end
            end
        end
        err = Mi-Dfxo;
        alph_err = alph*err/alph; 
        cM_temp = alph_err'+alph_err;
        c_temp = max(eig(cM_temp));
        if c_temp>c
            c = c_temp;
            cM = cM_temp;
        end
    end
end